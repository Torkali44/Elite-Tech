APP_NAME="Elite Tech Community"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=elitetech
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@elitetech.local"
MAIL_FROM_NAME="${APP_NAME}"

# Set strong values in .env. Prefer a bcrypt hash for ADMIN_PASSWORD:
# php -r "echo password_hash('your-strong-password', PASSWORD_BCRYPT), PHP_EOL;"
ADMIN_EMAIL=
ADMIN_PASSWORD=
